# ─────────────────────────────────────────────────────────────────────────────
# Midnight Mission Sponsorship Identifier — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Required for AI features (pitch generation, contact research, company discovery)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Flask secret key (auto-generated dev key used if not set)
# SECRET_KEY=change-me-in-production

# Optional — database URL (defaults to SQLite in instance/ folder)
# DATABASE_URL=sqlite:///sponsorship.db
