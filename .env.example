# Copy this file to .env and fill in your values.
#
# To get these values:
# 1. Go to https://portal.azure.com
# 2. Navigate to "Azure Active Directory" > "App registrations" > "New registration"
# 3. Name your app (e.g. "Midnight Mission Tools"), leave Redirect URI blank
# 4. After creating, copy the "Application (client) ID" -> AZURE_CLIENT_ID
# 5. Copy the "Directory (tenant) ID"                  -> AZURE_TENANT_ID
# 6. Under "API permissions" > "Add a permission" > "Microsoft Graph" > "Delegated":
#      - Mail.Read
#      - Mail.Send
#      - User.Read
#    Then click "Grant admin consent" (or ask your IT admin to do so)
#
# For ANTHROPIC_API_KEY, log in at https://console.anthropic.com and create an API key.

AZURE_CLIENT_ID=your-application-client-id-here
AZURE_TENANT_ID=your-directory-tenant-id-here

# Anthropic API key (used by Claude to read and extract check data)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Who receives the gift-processing email report (comma-separated)
CHECK_REPORT_RECIPIENTS=tiffany@midnightmission.com,val@midnightmission.com

# Optional CC list (comma-separated, leave blank to skip)
CHECK_REPORT_CC=
